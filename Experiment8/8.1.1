#include <stdio.h>

    printf("Enter the vertex to be deleted : ");
    scanf("%d", &v);

    if (v < 1 || v > *N) {
        printf("Invalid vertex.\n");
        return;
    }

    GNODE temp = graph[v];
    while (temp != NULL) {
        GNODE t = temp;
        temp = temp->next;
        free(t);
    }
    graph[v] = NULL;

    for (int i = 1; i <= *N; i++) {
        GNODE curr = graph[i];
        GNODE prev = NULL;

        while (curr != NULL) {
            if (curr->vertex == v) {
                if (prev == NULL) {
                    graph[i] = curr->next;
                } else {
                    prev->next = curr->next;
                }
                GNODE t = curr;
                curr = curr->next;
                free(t);
            } else {
                prev = curr;
                curr = curr->next;
            }
        }
    }

    for (int i = v; i < *N; i++) {
        graph[i] = graph[i + 1];
    }

    graph[*N] = NULL;
    (*N)--;

    for (int i = 1; i <= *N; i++) {
        GNODE temp2 = graph[i];
        while (temp2 != NULL) {
            if (temp2->vertex > v) {
                temp2->vertex--;
            }
            temp2 = temp2->next;
        }
    }

    printf("After deleting vertex the adjacency list is : \n");
    print(N);
}
